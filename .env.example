# TEMPLATE .env untuk SERVER (/opt/fulmintis/.env)
# Salin ke server, isi nilai asli, lalu: chmod 600 .env
# JANGAN commit file .env yang berisi password asli.

SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=https://fulmintis.web.id

# ---- Database: master_data ----
MASTER_DATA_DB_URL=jdbc:postgresql://host.docker.internal:5432/master_data
MASTER_DATA_DB_USER=master_data_app
MASTER_DATA_DB_PASSWORD=GANTI_DENGAN_PASSWORD_MASTER_DATA_APP

# ---- Database: frontline ----
FRONTLINE_DB_URL=jdbc:postgresql://host.docker.internal:5432/frontline
FRONTLINE_DB_USER=frontline_app
FRONTLINE_DB_PASSWORD=GANTI_DENGAN_PASSWORD_FRONTLINE_APP

# ---- SMTP SumoPod (salin dari dashboard SumoPod) ----
MAIL_HOST=smtp.sumopod.com
MAIL_PORT=465
MAIL_USERNAME=ISI_SMTP_USERNAME_DARI_SUMOPOD
MAIL_PASSWORD=ISI_SMTP_PASSWORD_DARI_SUMOPOD
MAIL_FROM=Fulmintis <noreply@fulmintis.web.id>

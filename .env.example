# filepath: /.env.example
# Salin ke ".env" di server (cp .env.example .env) lalu isi. JANGAN commit .env.
# Perintah bantu: openssl rand -base64 48   (untuk JWT_SECRET dan DB_PASSWORD)

# URL publik aplikasi (https, tanpa slash di akhir). Dipakai link email & CORS.
PUBLIC_URL=https://app.domainanda.com

# Database (satu user untuk database "frontline" dan "master_data")
DB_USERNAME=fulmintis
DB_PASSWORD=

# Minimal 32 karakter acak. JANGAN pakai secret dari lingkungan dev.
JWT_SECRET=

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Fulmintis <no-reply@domainanda.com>
BRAND_NAME=Fulmintis

# Port publik container web. Default hanya loopback; ubah WEB_BIND=0.0.0.0 bila tanpa proxy lain.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# true hanya jika SEMUA lalu lintas masuk lewat proxy tepercaya yang menimpa X-Forwarded-For.
RATE_LIMIT_TRUST_FORWARD_HEADERS=true

# AI (opsional). Kosongkan AI_PROVIDER = fitur Generate nonaktif.
# JANGAN isi "fake" (aplikasi sengaja gagal start di produksi).
# Provider gemini: wajib key project Google Cloud BERBAYAR + AI_BILLING_TIER=paid.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=
AI_BILLING_TIER=free
AI_FREE_MODEL=
AI_VIP_MODEL=
AI_GLOBAL_DAILY_LIMIT=0

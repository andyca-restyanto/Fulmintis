# TEMPLATE .env untuk SERVER (/opt/fulmintis/.env)
# Nama variabel mengikuti backend/src/main/resources/application-prod.properties.
# Salin ke server, isi nilai asli, lalu: chmod 600 .env
# JANGAN commit file .env yang berisi password/secret asli.

SPRING_PROFILES_ACTIVE=prod

# ---- Database UTAMA: frontline (dimigrasi oleh Flyway) ----
DB_URL=jdbc:postgresql://host.docker.internal:5432/frontline
DB_USERNAME=frontline_app
DB_PASSWORD=GANTI_PASSWORD_FRONTLINE_APP

# ---- Database KEDUA: master_data (migrasi manual, bukan Flyway) ----
MASTER_DB_URL=jdbc:postgresql://host.docker.internal:5432/master_data
MASTER_DB_USERNAME=master_data_app
MASTER_DB_PASSWORD=GANTI_PASSWORD_MASTER_DATA_APP

# ---- Keamanan ----
JWT_SECRET=GANTI_DENGAN_OUTPUT_openssl_rand_base64_64
CORS_ALLOWED_ORIGINS=https://fulmintis.web.id,https://www.fulmintis.web.id
# true karena Nginx MENIMPA X-Forwarded-For dengan IP klien asli
RATE_LIMIT_TRUST_FORWARD_HEADERS=true

# ---- URL publik ----
BACKEND_BASE_URL=https://fulmintis.web.id
FRONTEND_BASE_URL=https://fulmintis.web.id

# ---- SMTP SumoPod (port 465, SSL langsung) ----
MAIL_HOST=smtp.sumopod.com
MAIL_PORT=465
MAIL_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false
MAIL_USERNAME=ISI_SMTP_USERNAME_DARI_SUMOPOD
MAIL_PASSWORD=ISI_SMTP_PASSWORD_DARI_SUMOPOD
MAIL_FROM=Fulmintis <noreply@fulmintis.web.id>

# ---- Storage upload (path DI DALAM container, di-mount ke /opt/fulmintis-data/uploads) ----
STORAGE_BASE_DIR=/var/data/frontline-uploads

# ---- AI (kosong = fitur Generate nonaktif, aplikasi tetap start) ----
AI_PROVIDER=
